diff --git a/src/windows/a11y.zig b/src/windows/a11y.zig
new file mode 100644
index 0000000..f27fbfc
--- /dev/null
+++ b/src/windows/a11y.zig
@@ -0,0 +1,15 @@
+//! Windows accessibility preferences, read initially and on WM_SETTINGCHANGE.
+const w = @import("win32.zig");
+const Context = @import("../ui/context.zig").Context;
+
+/// Read the system's "Animation effects" preference without changing it.
+/// Failure leaves the last known preference intact.
+pub fn refresh(c: *Context) bool {
+    var enabled: w.BOOL = 1;
+    if (w.SystemParametersInfoW(w.SPI_GETCLIENTAREAANIMATION, 0, &enabled, 0) == 0) return false;
+    const reduce = enabled == 0;
+    const changed = c.reduced_motion != reduce or c.reduce_motion != reduce;
+    c.reduced_motion = reduce;
+    c.reduce_motion = reduce;
+    return changed;
+}
diff --git a/src/windows/folder_dialog.zig b/src/windows/folder_dialog.zig
new file mode 100644
index 0000000..942c53a
--- /dev/null
+++ b/src/windows/folder_dialog.zig
@@ -0,0 +1,139 @@
+//! Native folder selection through IFileOpenDialog. Vtable slots follow
+//! the Windows SDK's shobjidl.h; creating/configuring it shows no window.
+const std = @import("std");
+const w = @import("win32.zig");
+const Options = @import("../dialog_types.zig").OpenOptions;
+
+const clsid: w.Guid = .{ .a = 0xdc1c5a9c, .b = 0xe88a, .c = 0x4dde, .d = .{ 0xa5, 0xa1, 0x60, 0xf8, 0x2a, 0x20, 0xae, 0xf7 } };
+const iid: w.Guid = .{ .a = 0xd57c7288, .b = 0xd4ad, .c = 0x4768, .d = .{ 0xbe, 0x02, 0x9d, 0x96, 0x95, 0x32, 0xd9, 0x60 } };
+const iid_item: w.Guid = .{ .a = 0x43826d1e, .b = 0xe718, .c = 0x42ee, .d = .{ 0xbc, 0x55, 0xa1, 0xe2, 0x61, 0xc3, 0x7b, 0xfe } };
+const pick_folders: u32 = 0x20;
+const force_filesystem: u32 = 0x40;
+const allow_multiple: u32 = 0x200;
+const path_must_exist: u32 = 0x800;
+const force_hidden: u32 = 0x10000000;
+const cancelled: i32 = @bitCast(@as(u32, 0x800704c7));
+
+extern "ole32" fn CoTaskMemFree(p: ?*anyopaque) callconv(.winapi) void;
+extern "ole32" fn CoInitializeEx(reserved: ?*anyopaque, flags: u32) callconv(.winapi) i32;
+extern "ole32" fn CoUninitialize() callconv(.winapi) void;
+extern "user32" fn GetActiveWindow() callconv(.winapi) ?w.HWND;
+extern "shell32" fn SHCreateItemFromParsingName(path: [*:0]const u16, ctx: ?*anyopaque, riid: *const w.Guid, out: *?*anyopaque) callconv(.winapi) i32;
+
+const Com = extern struct {
+    vtable: [*]const *const anyopaque,
+
+    fn slot(self: *Com, comptime T: type, index: usize) T {
+        return @ptrCast(@alignCast(self.vtable[index]));
+    }
+
+    fn release(self: *Com) void {
+        _ = self.slot(*const fn (*Com) callconv(.winapi) u32, 2)(self);
+    }
+};
+
+fn check(result: i32) !void {
+    if (result < 0) return error.DialogFailed;
+}
+
+fn setText(gpa: std.mem.Allocator, dialog: *Com, slot: usize, text: []const u8) !void {
+    if (text.len == 0) return;
+    const wide = try std.unicode.utf8ToUtf16LeAllocZ(gpa, text);
+    defer gpa.free(wide);
+    try check(dialog.slot(*const fn (*Com, [*:0]const u16) callconv(.winapi) i32, slot)(dialog, wide));
+}
+
+fn create(gpa: std.mem.Allocator, opts: Options) !*Com {
+    var raw: ?*anyopaque = null;
+    try check(w.CoCreateInstance(&clsid, null, 1, &iid, &raw));
+    const dialog: *Com = @ptrCast(@alignCast(raw orelse return error.DialogFailed));
+    errdefer dialog.release();
+    var flags: u32 = 0;
+    try check(dialog.slot(*const fn (*Com, *u32) callconv(.winapi) i32, 10)(dialog, &flags));
+    flags |= pick_folders | force_filesystem | path_must_exist;
+    if (opts.multiple) flags |= allow_multiple;
+    if (opts.show_hidden) flags |= force_hidden;
+    try check(dialog.slot(*const fn (*Com, u32) callconv(.winapi) i32, 9)(dialog, flags));
+    try setText(gpa, dialog, 17, opts.title);
+    try setText(gpa, dialog, 18, opts.button);
+    if (opts.directory.len > 0) {
+        const path = try std.unicode.utf8ToUtf16LeAllocZ(gpa, opts.directory);
+        defer gpa.free(path);
+        var item_raw: ?*anyopaque = null;
+        try check(SHCreateItemFromParsingName(path, null, &iid_item, &item_raw));
+        const item: *Com = @ptrCast(@alignCast(item_raw orelse return error.DialogFailed));
+        defer item.release();
+        try check(dialog.slot(*const fn (*Com, *Com) callconv(.winapi) i32, 12)(dialog, item));
+    }
+    return dialog;
+}
+
+fn itemPath(gpa: std.mem.Allocator, item: *Com) ![]u8 {
+    var path: ?[*:0]u16 = null;
+    // SIGDN_FILESYSPATH returns a filesystem path, never a shell display name.
+    try check(item.slot(*const fn (*Com, u32, *?[*:0]u16) callconv(.winapi) i32, 5)(item, 0x80058000, &path));
+    const value = path orelse return error.DialogFailed;
+    defer CoTaskMemFree(value);
+    return std.unicode.utf16LeToUtf8Alloc(gpa, std.mem.span(value));
+}
+
+pub fn open(gpa: std.mem.Allocator, opts: Options) !?[][]u8 {
+    try check(CoInitializeEx(null, 2));
+    defer CoUninitialize();
+    const dialog = try create(gpa, opts);
+    defer dialog.release();
+    const result = dialog.slot(*const fn (*Com, ?w.HWND) callconv(.winapi) i32, 3)(dialog, GetActiveWindow());
+    if (result == cancelled) return null;
+    try check(result);
+    var items: ?*Com = null;
+    try check(dialog.slot(*const fn (*Com, *?*Com) callconv(.winapi) i32, 27)(dialog, &items));
+    const array = items orelse return error.DialogFailed;
+    defer array.release();
+    var count: u32 = 0;
+    try check(array.slot(*const fn (*Com, *u32) callconv(.winapi) i32, 7)(array, &count));
+    const paths = try gpa.alloc([]u8, count);
+    var filled: usize = 0;
+    errdefer {
+        for (paths[0..filled]) |path| gpa.free(path);
+        gpa.free(paths);
+    }
+    while (filled < count) : (filled += 1) {
+        var item: ?*Com = null;
+        try check(array.slot(*const fn (*Com, u32, *?*Com) callconv(.winapi) i32, 8)(array, @intCast(filled), &item));
+        const entry = item orelse return error.DialogFailed;
+        defer entry.release();
+        paths[filled] = try itemPath(gpa, entry);
+    }
+    return paths;
+}
+
+test "native folder dialog configures folder selection without showing a window" {
+    try check(CoInitializeEx(null, 2));
+    defer CoUninitialize();
+    var tmp = std.testing.tmpDir(.{});
+    defer tmp.cleanup();
+    try tmp.dir.createDir(std.testing.io, "Māori folder", .default_dir);
+    const path = try tmp.dir.realPathFileAlloc(std.testing.io, "Māori folder", std.testing.allocator);
+    defer std.testing.allocator.free(path);
+    const dialog = try create(std.testing.allocator, .{
+        .files = false,
+        .directories = true,
+        .multiple = true,
+        .show_hidden = true,
+        .title = "Choose a folder",
+        .button = "Scan folder",
+        .directory = path,
+    });
+    defer dialog.release();
+    var flags: u32 = 0;
+    try check(dialog.slot(*const fn (*Com, *u32) callconv(.winapi) i32, 10)(dialog, &flags));
+    const required = pick_folders | force_filesystem | path_must_exist | allow_multiple | force_hidden;
+    try std.testing.expectEqual(required, flags & required);
+    var item: ?*Com = null;
+    try check(dialog.slot(*const fn (*Com, *?*Com) callconv(.winapi) i32, 13)(dialog, &item));
+    const folder = item orelse return error.DialogFailed;
+    defer folder.release();
+    const actual = try itemPath(std.testing.allocator, folder);
+    defer std.testing.allocator.free(actual);
+    try std.testing.expectEqualStrings(path, actual);
+}
